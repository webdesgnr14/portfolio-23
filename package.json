    "buffer": "^6.0.3",
    "canvas-confetti": "^1.9.3",
    "copy-webpack-plugin": "^13.0.0",
    "cssnano": "^7.1.0",
    "dotenv-webpack": "^8.1.1",
    "glob": "^11.0.3",
    "mini-css-extract-plugin": "^2.9.3",
    "node-sass": "^9.0.0",
    "node-sass-package-importer": "^5.3.3",
    "nodemon": "^3.1.10",
